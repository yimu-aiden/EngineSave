{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enginesave/import.schema.json",
  "title": "enginesave import --json",
  "description": "Output of `enginesave import ... --yes --json` (0.3.0, D24). Since 0.5.0 (D31) an archive the repository already holds as an import is skipped: result null, reason \"already imported\", exit code 0; --reimport imports it again.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "result", "reason"],
  "properties": {
    "plan": { "$ref": "#/$defs/plan" },
    "result": { "type": ["object", "null"], "$ref": "#/$defs/result" },
    "reason": { "enum": ["already imported", null], "description": "why nothing was imported" }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "archive",
        "display_name",
        "game_id",
        "matched_by",
        "source_snapshot_id",
        "source_status",
        "exported_at",
        "file_count",
        "total_bytes",
        "includes_tokens",
        "ignored_members",
        "already_imported",
        "duplicate_of"
      ],
      "properties": {
        "repository": { "type": "string" },
        "archive": { "type": "string" },
        "display_name": { "type": "string" },
        "game_id": { "type": "string", "description": "record that receives the snapshot" },
        "matched_by": {
          "enum": ["game_id", "identity", null],
          "description": "game_id: same record id; identity: plan 6.6 rules; null: a new record"
        },
        "source_snapshot_id": { "type": "string" },
        "source_status": { "enum": ["complete", "partial"] },
        "exported_at": { "type": ["string", "null"] },
        "file_count": { "type": "integer" },
        "total_bytes": { "type": "integer" },
        "includes_tokens": { "type": "boolean" },
        "ignored_members": {
          "type": "integer",
          "description": "data/ members of the archive that its manifest does not list"
        },
        "already_imported": {
          "type": ["object", "null"],
          "$ref": "#/$defs/earlier",
          "description": "the import snapshot that already holds this exported snapshot (same original record id and snapshot id in imported_from), or null"
        },
        "duplicate_of": {
          "type": ["string", "null"],
          "description": "0.6.0: always null for a single archive (see import-batch)"
        }
      }
    },
    "earlier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game_id", "snapshot_id"],
      "properties": {
        "game_id": { "type": "string" },
        "snapshot_id": { "type": "string" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_id",
        "display_name",
        "snapshot_id",
        "created_record",
        "file_count",
        "total_bytes",
        "storage"
      ],
      "properties": {
        "game_id": { "type": "string" },
        "display_name": { "type": "string" },
        "snapshot_id": { "type": "string", "description": "the new snapshot (reason import)" },
        "created_record": { "type": "boolean" },
        "file_count": { "type": "integer" },
        "total_bytes": { "type": "integer" },
        "storage": { "enum": ["hardlink", "copy", "mixed"] }
      }
    }
  }
}
